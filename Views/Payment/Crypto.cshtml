@model ecommerce.ViewModels.Payment.CryptoCheckoutViewModel
@{
    ViewData["Title"] = "Pay with crypto";
    Layout = "~/Views/Shared/_CheckoutLayout.cshtml";
}

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="section-title"><h3 class="title">Pay with @Model.Currency</h3></div>

                <div class="alert alert-info">
                    @if (Model.ExpectedAmount.HasValue)
                    {
                        <p>
                            Send <strong>@Model.ExpectedAmount.Value.ToString("0.########") @Model.Currency</strong>
                            (= $@Model.AmountUsd) on the <strong>@Model.Network</strong> network to the address below.
                        </p>
                        <p class="mb-0">
                            After sending, paste the transaction hash. We will verify the payment on-chain
                            and email you once it is confirmed. (If your transaction differs by more than a
                            small tolerance, it will be rejected and an admin will review it manually.)
                        </p>
                    }
                    else
                    {
                        <p>
                            Send the equivalent of <strong>$@Model.AmountUsd</strong> in
                            <strong>@Model.Currency</strong> (network: <strong>@Model.Network</strong>) to the address below.
                            Live price was unavailable, so amount will be reconciled manually by an admin.
                        </p>
                    }
                </div>

                <div class="form-group">
                    <label>Wallet address</label>
                    <div class="input-group">
                        <input id="walletAddr" type="text" class="form-control" value="@Model.WalletAddress" readonly />
                        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText(document.getElementById('walletAddr').value)">Copy</button>
                    </div>
                </div>

                <form asp-action="SubmitCryptoTx" method="post" class="mt-3">
                    <input type="hidden" asp-for="PaymentId" value="@Model.PaymentId" />
                    <div class="form-group">
                        <label asp-for="TxHash">Transaction hash</label>
                        <input asp-for="TxHash" class="form-control" placeholder="0x... or tx id" required />
                        <span asp-validation-for="TxHash" class="text-danger"></span>
                    </div>
                    <button type="submit" class="primary-btn">Submit transaction</button>
                </form>
            </div>
        </div>
    </div>
</div>
